<Window x:Class="SnapshotRail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clothesline" Icon="{StaticResource SnapshotRailIcon}" Width="1600" Height="310" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded" Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">
  <Grid>
      <Grid Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,12,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Clothesline" Foreground="#FFF8FAFC" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Text="  截图与剪贴板图片" Foreground="#FFCBD5E1" FontSize="11" Margin="5,1,0,0" />
          <TextBlock x:Name="StatusText" Foreground="#FF93C5FD" FontSize="10" Margin="12,2,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="保存剪贴板" Height="24" Padding="9,0" Margin="0,0,8,0"
                  Background="#FF334155" Foreground="#FFF8FAFC" BorderBrush="#FF475569"
                  BorderThickness="1" FontSize="10" ToolTip="把当前剪贴板中的图片保存为 PNG"
                  Click="SaveClipboard_Click" />
          <Button Content="×" Width="25" Height="24" Background="Transparent"
                  Foreground="#FFCBD5E1" BorderThickness="0" FontSize="17" ToolTip="退出" Click="Exit_Click" />
        </StackPanel>
      </Grid>
      <Grid x:Name="LineSurface" ClipToBounds="False" Margin="0,0,0,5">
        <Canvas x:Name="RopeCanvas" IsHitTestVisible="False">
          <Path x:Name="RopeShadow" Stroke="#55000000" StrokeThickness="2.2" />
          <Path x:Name="RopeLine" Stroke="#FF9098A5" StrokeThickness="1.5" />
          <Path x:Name="RopeHighlight" Stroke="#66FFFFFF" StrokeThickness="0.6" />
        </Canvas>
        <Canvas x:Name="CardsCanvas" />
        <TextBlock x:Name="EmptyHint" Text="截一张图，它会挂在这里" Foreground="#FFCBD5E1"
                   FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0" />
      </Grid>
  </Grid>
</Window>
